# VoiceLoop 环境配置
# 可选覆盖。默认值对本地 macOS 语音备忘录工作流是安全的。

# 语音备忘录源目录（默认已指向系统目录，一般无需修改）
VOICELOOP_SOURCE_DIR="~/Library/Group Containers/group.com.apple.VoiceMemos.shared/Recordings/"

# 数据输出目录
VOICELOOP_DATA_DIR="./data"

# iCloud 同步目录（纪要和周报自动同步到此）
VOICELOOP_SYNC_DIR="~/Library/Mobile Documents/com~apple~CloudDocs/数据同步/voiceloop"

# 项目根目录
VOICELOOP_REPO_ROOT="."

# 续录候选窗口：前段结束到后段开始的最大间隔（分钟）。还需 AI 确认上下文接续。
# 设为 0 关闭自动归组；支持在 .env 或环境变量中配置。
VOICELOOP_SESSION_GAP_MINUTES="10"

# ---------------------------------------------------------------------------
# 纪要及周报模型。可选 kimi / deepseek / api；命令行参数可临时覆盖。
VOICELOOP_MINUTES_ENGINE="kimi"

# Kimi Code OpenAI 兼容接口
# ---------------------------------------------------------------------------
# Kimi Code Console 的 API Key（需与 coding/v1 地址匹配）
KIMI_API_KEY=""

# OpenAI Chat Completions 兼容地址
KIMI_BASE_URL="https://api.kimi.com/coding/v1"
KIMI_MODEL="kimi-for-coding"

# 方式2：使用 Kimi CLI 凭证（当 KIMI_API_KEY 未设置时回退）
# 需要先运行 'kimi login' 生成 ~/.kimi/credentials/kimi-code.json

# DeepSeek（将 VOICELOOP_MINUTES_ENGINE 设为 deepseek）
# DEEPSEEK_API_KEY=""
# DEEPSEEK_BASE_URL="https://api.deepseek.com"
# DEEPSEEK_MODEL="deepseek-flash"

# 其他 OpenAI Chat Completions 兼容接口（engine=api）
# VOICELOOP_LLM_API_KEY=""
# VOICELOOP_LLM_BASE_URL="https://provider.example/v1"
# VOICELOOP_LLM_MODEL="model-id"

# ---------------------------------------------------------------------------
# 可选：外部 ASR API（替代本地 MLX）
# ---------------------------------------------------------------------------
# VOICELOOP_ASR_API_URL="https://api.openai.com/v1/audio/transcriptions"
# VOICELOOP_ASR_API_KEY="sk-..."
# VOICELOOP_ASR_API_MODEL="whisper-1"

# ---------------------------------------------------------------------------
# 可选：iMessage 通知（新纪要生成后推送，走本机 macos-notify 共享通道）
# ---------------------------------------------------------------------------
# 接收人手机号或 Apple ID 邮箱，留空则不通知
VOICELOOP_NOTIFY_TO=""
# 共享通道脚本路径（一般无需修改）
# VOICELOOP_NOTIFY_SCRIPT="~/projects/tools/macos-notify/send-imessage.sh"
